 #include "hw/virtio/virtio-serial.h"
 #include "ui/pingouin-splash.h"   /* the logo's cells, the animation's core */
+#include "ui/pingouin-splash-art.h"   /* the penguin's outline */
 
+/* The glow's colours: the app icon's stripes (app/Resources/Pingouin.icon). */
+static const uint32_t pingouin_stripes[6] = {
+    0x5ebd3e, 0xffb900, 0xf78200, 0xe23838, 0x973999, 0x009cdf,
+};
+#define PINGOUIN_SPLASH_GREY 0.05       /* the background */
+#define PINGOUIN_GLOW_ALPHA 0.65
+#define PINGOUIN_GLOW_RADIUS 0.537      /* each colour's, of the output's height */
+#define PINGOUIN_GLOW_SPREAD 0.215      /* the colours around the middle, of the height */
+#define PINGOUIN_GLOW_TURN_S 25.0       /* one turn of the glow (the overlay layer) */
+#define PINGOUIN_PENGUIN_SCALE 2.25     /* its height, of the output's: only its head shows */
+
+/*
+ * The penguin's outline for a w x h output, Core Graphics' way up (y from the
+ * bottom), framed as in the icon: its middle a third of the height left of the
+ * output's and 0.905 of the height below it, so its head and neck show.
+ * Catmull-Rom curves through the traced points. Release it.
+ */
+static CGPathRef pingouin_penguin_path(double w, double h)
+{
+    double ph = h * PINGOUIN_PENGUIN_SCALE, pw = ph * PINGOUIN_PENGUIN_ASPECT;
+    double x0 = w / 2 - 0.33 * h - pw / 2, y0 = h / 2 - 927.0 / 1024 * h - ph / 2;
+    CGMutablePathRef path = CGPathCreateMutable();
+    size_t base = 0;
+
+    for (size_t l = 0; l < ARRAY_SIZE(pingouin_penguin_loop_len); l++) {
+        int n = pingouin_penguin_loop_len[l];
+#define PT(k) CGPointMake(x0 + pingouin_penguin_pts[base + (((k) % n) + n) % n][0] * pw, \
+                          y0 + (1 - pingouin_penguin_pts[base + (((k) % n) + n) % n][1]) * ph)
+        CGPoint first = PT(0);
+        CGPathMoveToPoint(path, NULL, first.x, first.y);
+        for (int k = 0; k < n; k++) {
+            CGPoint p0 = PT(k - 1), p1 = PT(k), p2 = PT(k + 1), p3 = PT(k + 2);
+            CGPathAddCurveToPoint(path, NULL,
+                                  p1.x + (p2.x - p0.x) / 6, p1.y + (p2.y - p0.y) / 6,
+                                  p2.x - (p3.x - p1.x) / 6, p2.y - (p3.y - p1.y) / 6,
+                                  p2.x, p2.y);
+        }
+#undef PT
+        CGPathCloseSubpath(path);
+        base += n;
+    }
+    return path;
+}
+
+/* The glow around (cx, cy) for an output h high: six soft discs of colour. */
+static void pingouin_glow_draw(CGContextRef cg, CGColorSpaceRef space, double cx, double cy, double h)
+{
+    for (int i = 0; i < 6; i++) {
+        uint32_t c = pingouin_stripes[i];
+        CGFloat on[4] = { (c >> 16) / 255.0, ((c >> 8) & 0xff) / 255.0, (c & 0xff) / 255.0,
+                          PINGOUIN_GLOW_ALPHA };
+        CGFloat off[4] = { on[0], on[1], on[2], 0 };
+        CGColorRef cols[2] = { CGColorCreate(space, on), CGColorCreate(space, off) };
+        CFArrayRef arr = CFArrayCreate(NULL, (const void **)cols, 2, &kCFTypeArrayCallBacks);
+        CGGradientRef g = CGGradientCreateWithColors(space, arr, NULL);
+        double a = i / 6.0 * 2 * M_PI + M_PI / 2;
+        CGPoint at = CGPointMake(cx + cos(a) * PINGOUIN_GLOW_SPREAD * h,
+                                 cy + sin(a) * PINGOUIN_GLOW_SPREAD * 0.75 * h);
+
+        CGContextDrawRadialGradient(cg, g, at, 0, at, PINGOUIN_GLOW_RADIUS * h, 0);
+        CGGradientRelease(g);
+        CFRelease(arr);
+        CGColorRelease(cols[0]);
+        CGColorRelease(cols[1]);
+    }
+}
+
+static CGContextRef pingouin_splash_context(uint8_t *px, int w, int h, CGColorSpaceRef space)
+{
+    return CGBitmapContextCreate(px, w, h, 8, (size_t)w * 4, space,
+                                 kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+}
+
+/*
+ * The splash at w x h pixels, still (the glow unturned): premultiplied RGBA
+ * bytes, first row the top, sRGB values (shown unconverted, as GL's are).
+ * g_free() them.
+ */
+static uint8_t *pingouin_splash_pixels(int w, int h)
+{
+    uint8_t *px = g_malloc0((size_t)w * h * 4);
+    CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGContextRef cg = pingouin_splash_context(px, w, h, srgb);
+
+    if (cg) {
+        CGContextSetRGBFillColor(cg, PINGOUIN_SPLASH_GREY, PINGOUIN_SPLASH_GREY, PINGOUIN_SPLASH_GREY, 1);
+        CGContextFillRect(cg, CGRectMake(0, 0, w, h));
+        pingouin_glow_draw(cg, srgb, w / 2.0, h / 2.0, h);
+        CGPathRef path = pingouin_penguin_path(w, h);
+        CGContextAddPath(cg, path);
+        CGContextSetRGBFillColor(cg, 0, 0, 0, 1);
+        CGContextEOFillPath(cg);
+        CGPathRelease(path);
+        CGContextRelease(cg);
+    }
+    CGColorSpaceRelease(srgb);
+    return px;
+}
+
+/*
+ * The glow alone, on transparency, side x side pixels (the diagonal of an
+ * output h high: it turns without showing its corners), for the overlay
+ * layer that turns it. Tagged with space, as the layer's other colours.
+ */
+static CGImageRef pingouin_glow_image(int side, int h, CGColorSpaceRef space)
+{
+    uint8_t *px = g_malloc0((size_t)side * side * 4);
+    CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGContextRef cg = pingouin_splash_context(px, side, side, srgb);
+    CGImageRef image = NULL;
+
+    if (cg) {
+        pingouin_glow_draw(cg, srgb, side / 2.0, side / 2.0, h);
+        CGContextRelease(cg);
+        CFDataRef bytes = CFDataCreate(NULL, px, (CFIndex)side * side * 4);
+        CGDataProviderRef data = CGDataProviderCreateWithCFData(bytes);
+        image = CGImageCreate(side, side, 8, 32, (size_t)side * 4, space,
+                              (CGBitmapInfo)kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big,
+                              data, NULL, false, kCGRenderingIntentDefault);
+        CGDataProviderRelease(data);
+        CFRelease(bytes);
+    }
+    CGColorSpaceRelease(srgb);
+    g_free(px);
+    return image;
+}
