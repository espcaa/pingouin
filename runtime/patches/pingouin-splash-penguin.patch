+/* The app icon's stripes, top to bottom (app/Resources/icon/pingouin-icon.svg). */
+static const uint32_t pingouin_stripes[6] = {
+    0x87c463, 0xf7c751, 0xee9a40, 0xdb5e51, 0x9f57a6, 0x54abe1,
+};
+#define PINGOUIN_PENGUIN_HEIGHT 0.42   /* of the output's height */
+
+/* The penguin, decoded once (any thread). */
+static CGImageRef pingouin_penguin(void)
+{
+    static CGImageRef image;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        CFDataRef d = CFDataCreateWithBytesNoCopy(NULL, pingouin_penguin_png,
+                                                  sizeof(pingouin_penguin_png),
+                                                  kCFAllocatorNull);
+        CGDataProviderRef p = CGDataProviderCreateWithCFData(d);
+
+        image = CGImageCreateWithPNGDataProvider(p, NULL, true, kCGRenderingIntentDefault);
+        CGDataProviderRelease(p);
+        CFRelease(d);
+        if (!image) {
+            warn_report("cocoa: boot splash: the penguin did not decode");
+        }
+    });
+    return image;
+}
+
+/*
+ * The splash at w x h pixels: premultiplied RGBA bytes, first row the top,
+ * sRGB values (shown unconverted, as GL's are). g_free() them.
+ */
+static uint8_t *pingouin_splash_pixels(int w, int h)
+{
+    uint8_t *px = g_malloc0((size_t)w * h * 4);
+    CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGContextRef cg = CGBitmapContextCreate(px, w, h, 8, (size_t)w * 4, srgb,
+                                            kCGImageAlphaPremultipliedLast |
+                                            kCGBitmapByteOrder32Big);
+    CGImageRef penguin = pingouin_penguin();
+
+    CGColorSpaceRelease(srgb);
+    if (!cg) {
+        return px;
+    }
+    for (int i = 0; i < 6; i++) {
+        uint32_t c = pingouin_stripes[i];
+        /* CG counts from the bottom; whole rows, no seams. */
+        double top = floor((double)h * i / 6), bottom = floor((double)h * (i + 1) / 6);
+
+        CGContextSetRGBFillColor(cg, (c >> 16) / 255.0, ((c >> 8) & 0xff) / 255.0,
+                                 (c & 0xff) / 255.0, 1);
+        CGContextFillRect(cg, CGRectMake(0, h - bottom, w, bottom - top));
+    }
+    if (penguin) {
+        double ph = round(h * PINGOUIN_PENGUIN_HEIGHT);
+        double pw = round(ph * CGImageGetWidth(penguin) / CGImageGetHeight(penguin));
+
+        CGContextSetInterpolationQuality(cg, kCGInterpolationHigh);
+        CGContextDrawImage(cg, CGRectMake(floor((w - pw) / 2), floor((h - ph) / 2), pw, ph),
+                           penguin);
+    }
+    CGContextRelease(cg);
+    return px;
+}
