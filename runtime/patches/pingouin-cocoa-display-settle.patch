+/* The session's own word: locked, or another user on the console. */
+static void pingouin_ds_session(bool *locked, bool *away)
+{
+    CFDictionaryRef d = CGSessionCopyCurrentDictionary();
+    CFTypeRef v;
+    int n = 0;
+
+    *locked = *away = false;
+    if (!d) {
+        return;
+    }
+    v = CFDictionaryGetValue(d, CFSTR("CGSSessionScreenIsLocked"));
+    if (v && CFGetTypeID(v) == CFBooleanGetTypeID()) {
+        *locked = CFBooleanGetValue(v);
+    } else if (v && CFGetTypeID(v) == CFNumberGetTypeID()) {
+        *locked = CFNumberGetValue(v, kCFNumberIntType, &n) && n;
+    }
+    v = CFDictionaryGetValue(d, kCGSessionOnConsoleKey);
+    if (v && CFGetTypeID(v) == CFBooleanGetTypeID()) {
+        *away = !CFBooleanGetValue(v);
+    }
+    CFRelease(d);
+}
+
+static void pingouin_displays_update(void)
+{
+    double at;
+
+    /* A change while locked for a while: a missed unlock or wake must not stop them for good. */
+    if (pingouin_ds_timer.locked && pingouin_ds_clock() - pingouin_ds_locked_at > 5) {
+        bool locked, away;
+        pingouin_ds_session(&locked, &away);
+        if ((pingouin_ds_screen_locked && !locked) || (pingouin_ds_away && !away) ||
+            (pingouin_ds_asleep && !CGDisplayIsAsleep(CGMainDisplayID()))) {
+            pingouin_ds_screen_locked = locked;
+            pingouin_ds_away = away;
+            pingouin_ds_asleep = CGDisplayIsAsleep(CGMainDisplayID());
+            pingouin_ds_lock_changed("the session says so");
+        }
+    }
+    if (pingouin_ds_ask(&pingouin_ds_timer, pingouin_ds_clock(), PINGOUIN_DS_SETTLE_S, &at)) {
+        pingouin_ds_arm(at);
+    }
+}
