+
+    if (locked != pingouin_ds_timer.locked) {
+        pingouin_ds_locked_at = pingouin_ds_clock();
+        fprintf(stderr, "pingouin: displays: %s (%s)\n", locked ?
+                "no window changes while locked or asleep" :
+                "windows follow the displays again once they settle", why);
+    }
+    if (pingouin_ds_lock(&pingouin_ds_timer, locked, pingouin_ds_clock(), &at)) {
+        pingouin_ds_arm(at);
+    }
+}
