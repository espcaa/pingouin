+/* A display's window goes for good. */
+static void pingouin_head_close(NSWindow *w)
+{
+    [w orderOut:nil];
+    [w setDelegate:nil];
+    [w close];
+}
+
+/*
+ * Pingouin (#428): a display window that went while macOS moved it into or out
+ * of full screen is closed once macOS is done (its delegate's calls), or
+ * after 4 s. Closed in the middle, AppKit kept it and its full-screen Space
+ * until QEMU quit.
+ */
+static void pingouin_head_leave(NSWindow *w)
+{
+    if (!pingouin_heads_leaving) {
+        pingouin_heads_leaving = [[NSMutableArray alloc] init];
+    }
+    [w setAlphaValue:0.0];
+    [pingouin_heads_leaving addObject:w];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 4 * NSEC_PER_SEC),
+                   dispatch_get_main_queue(), ^{ pingouin_head_left(w); });
+}
+
+static void pingouin_head_left(NSWindow *w)
+{
+    if (w && [pingouin_heads_leaving containsObject:w]) {
+        pingouin_head_close(w);
+        [pingouin_heads_leaving removeObject:w];
+    }
+}
