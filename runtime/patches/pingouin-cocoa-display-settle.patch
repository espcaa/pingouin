+/*
+ * Pingouin (#428): every display change asks for an update here, and it runs
+ * from a timer once the displays settle: never inside the window or screen
+ * notification that asked, never inside another update, never while the
+ * screen is locked or the displays sleep (ui/pingouin-display-settle.h).
+ */
+static bool pingouin_ds_screen_locked, pingouin_ds_asleep, pingouin_ds_away, pingouin_ds_test_locked;
+static double pingouin_ds_locked_at;
+
+static void pingouin_ds_fired(void);
+
+static void pingouin_ds_arm(double at)
+{
+    double wait = MAX(0.0, at - pingouin_ds_clock());
+
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(wait * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{ pingouin_ds_fired(); });
+}
+
+static void pingouin_ds_fired(void)
+{
+    double at, retry;
+
+    switch (pingouin_ds_fire(&pingouin_ds_timer, pingouin_ds_clock(), &at)) {
+    case PINGOUIN_DS_REARM:
+        pingouin_ds_arm(at);
+        return;
+    case PINGOUIN_DS_SKIP:
+        return;
+    case PINGOUIN_DS_RUN:
+        break;
+    }
+    retry = pingouin_displays_apply();
+    if (pingouin_ds_done(&pingouin_ds_timer, pingouin_ds_clock(), retry, &at)) {
+        pingouin_ds_arm(at);
+    }
+}
