+/*
+ * The lock and sleep notifications (delivered also while the app is in the
+ * background). PINGOUIN_TEST_LOCK_HOOK=1: app.pingouin.test.lock and
+ * app.pingouin.test.unlock (distributed) stand for them, so the locked path is
+ * tested without locking the test Mac.
+ */
+@interface PingouinLockWatch : NSObject
+@end
+
+@implementation PingouinLockWatch
+- (void)locked:(NSNotification *)n
+{
+    pingouin_ds_screen_locked = true;
+    pingouin_ds_lock_changed("screen locked");
+}
+- (void)unlocked:(NSNotification *)n
+{
+    pingouin_ds_screen_locked = false;
+    pingouin_ds_lock_changed("screen unlocked");
+}
+- (void)asleep:(NSNotification *)n
+{
+    pingouin_ds_asleep = true;
+    pingouin_ds_lock_changed("displays asleep");
+}
+- (void)awake:(NSNotification *)n
+{
+    pingouin_ds_asleep = false;
+    pingouin_ds_lock_changed("displays awake");
+}
+- (void)away:(NSNotification *)n
+{
+    pingouin_ds_away = true;
+    pingouin_ds_lock_changed("another user");
+}
+- (void)back:(NSNotification *)n
+{
+    pingouin_ds_away = false;
