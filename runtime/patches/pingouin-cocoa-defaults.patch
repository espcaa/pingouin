From: Pingouin
Subject: [PATCH] cocoa: Pingouin's default for code kept only as a dependency

What: the Hyprland scale-step size snapping (pingouin-cocoa-clean-size.patch:
guest sizes, 20 point window steps, rows cut below the notch) only happens
with PINGOUIN_CLEAN_SIZE=1. Without it the guest gets the view's exact size.
Why: the patch stays because later patches (FullPanel) are written on top
of it, but it is Omarchy-specific. (The boot splash, also kept: pingouin-splash-penguin.patch.) Last in the qemu list.
---
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -554,6 +554,21 @@
 static void pingouin_fp_scale_load(void);
 /* Pingouin: points cut off the bottom of the full-screen area for the guest. */
 static CGFloat pingouin_full_cut;
+/*
+ * Pingouin: guest and window sizes snapped to Hyprland's scale steps
+ * (ui/pingouin-clean-size.h) only with PINGOUIN_CLEAN_SIZE=1; otherwise the guest
+ * gets the view's exact pixel size and the window resizes freely.
+ */
+static bool pingouin_clean_sizes(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *v = getenv("PINGOUIN_CLEAN_SIZE");
+        on = v && !strcmp(v, "1");
+    }
+    return on;
+}
 /*
  * Pingouin: the full-screen window fills the area and shows the guest at its
  * top, pixel for pixel, the cut rows black below it. The window keeps the
@@ -1967,9 +1982,11 @@
      * Pingouin: a size Omarchy's scale presets fit (ui/pingouin-clean-size.h).
      * In full screen a few rows less; they stay black at the bottom.
      */
-    PingouinSize clean = pingouin_clean_size(backingFrameSize.width,
-                                         backingFrameSize.height,
-                                         backingScale, full);
+    PingouinSize clean = pingouin_clean_sizes()
+        ? pingouin_clean_size(backingFrameSize.width, backingFrameSize.height,
+                              backingScale, full)
+        : (PingouinSize){ (uint32_t)backingFrameSize.width,
+                          (uint32_t)backingFrameSize.height };
     info.width = clean.w;
     info.height = clean.h;
     if (panel) {
@@ -5162,8 +5179,9 @@
     NSRect available = [hostScreen visibleFrame];
     CGFloat unit = floor(MIN(NSWidth(available) * 0.75 / 16.0,
                              NSHeight(available) * 0.75 / 9.0));
-    NSSize size = NSMakeSize(pingouin_window_step(16.0 * unit),
-                             pingouin_window_step(9.0 * unit));
+    NSSize size = pingouin_clean_sizes()
+        ? NSMakeSize(pingouin_window_step(16.0 * unit), pingouin_window_step(9.0 * unit))
+        : NSMakeSize(16.0 * unit, 9.0 * unit);
 
     return NSMakeRect(floor(NSMidX(available) - size.width / 2.0),
                       floor(NSMidY(available) - size.height / 2.0),
@@ -5595,6 +5613,9 @@
     NSRect c = [w contentRectForFrameRect:frame];
     CGFloat top = NSMaxY(c);
 
+    if (!pingouin_clean_sizes()) {
+        return frame;
+    }
     c.size.width = pingouin_window_step(c.size.width);
     c.size.height = pingouin_window_step(c.size.height);
     c.origin.y = top - c.size.height;
