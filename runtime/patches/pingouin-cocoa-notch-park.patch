+/* NOTCH's top row above an output's middle, from the layout the guest reported. */
+static bool pingouin_notch_park_target(int output, double *nx, double *ny)
+{
+    const PingouinBox *s, *n = &pingouin_guest_notch;
+    const PingouinBox *a = &pingouin_guest_bounds;
+
+    if (!pingouin_guest_known || output < 0 || output >= PINGOUIN_MAX_OUTPUTS) {
+        return false;
+    }
+    s = &pingouin_guest_box[output];
+    return pingouin_park_place((PingouinParkBox){ s->x, s->y, s->w, s->h },
+                             (PingouinParkBox){ n->x, n->y, n->w, n->h },
+                             (PingouinParkBox){ a->x, a->y, a->w, a->h }, nx, ny);
+}
+
+/*
+ * At the strip's edge the Mac's cursor changes with the guest's frame, not
+ * before it. The guest draws its own pointer a frame or two after QEMU
+ * moved it (Hyprland, virgl, this present): up into the strip the guest's
+ * arrow still showed on the VM's top rows next to the Mac's for that long,
+ * and back into the VM there was no arrow at all. Now the Mac's cursor
+ * stays hidden (up) or shown (back) until a guest frame flushed after the
+ * move is on the layer, at most PINGOUIN_PARK_HOLD_MAX_MS. Main thread.
+ * PINGOUIN_PARK_HOLD=0: off (as before); PINGOUIN_PARK_MARGIN_MS: how long
+ * after the move a flushed frame may still be one drawn before it.
+ */
+#define PINGOUIN_PARK_HOLD_MAX_MS 80
+static int pingouin_park_hold;            /* -1 hidden (up), 1 shown (back), 0 none */
+static unsigned pingouin_park_hold_gen;
+static double pingouin_park_hold_at;      /* CACurrentMediaTime() of the move */
+
+static int pingouin_park_hold_now(void)
+{
+    return pingouin_park_hold;
+}
+
+static void pingouin_park_hold_end(const char *why)
+{
+    pingouin_park_hold = 0;
+    qatomic_set(&pingouin_park_hold_on, 0);
+    if (pingouin_pointer_debug) {
+        fprintf(stderr, "pingouin-pointer: %.4f strip hold ends (%s)\n", CACurrentMediaTime(), why);
+    }
+    [cocoaView pingouinUpdateMacCursor];
+}
+
+static double pingouin_park_margin(void)
+{
+    static double m = -1;
+    if (m < 0) {
+        const char *e = getenv("PINGOUIN_PARK_MARGIN_MS");
+        m = e ? MAX(0, atof(e)) / 1000.0 : 0.004;
+    }
+    return m;
+}
+
+static void pingouin_park_hold_start(bool up)
+{
+    static int on = -1;
+    unsigned gen;
+
+    if (on < 0) {
+        const char *e = getenv("PINGOUIN_PARK_HOLD");
+        on = !(e && !strcmp(e, "0"));
+    }
+    if (!up) {
+        pingouin_parked = false;
+    }
+    /* only where QEMU sees the guest's frames go on screen */
+    bool frames = false;
+#ifdef CONFIG_OPENGL
+    frames = present_ctx != NULL;
+#endif
+    if (!on || !frames) {
+        return;
+    }
+    pingouin_park_hold = up ? -1 : 1;
+    pingouin_park_hold_at = CACurrentMediaTime();
+    gen = ++pingouin_park_hold_gen;
+    qatomic_set(&pingouin_park_hold_on, 1);
+    if (pingouin_pointer_debug) {
+        fprintf(stderr, "pingouin-pointer: %.4f strip hold starts (%s)\n", pingouin_park_hold_at,
+                up ? "up: Mac cursor hidden" : "back: Mac cursor shown");
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, PINGOUIN_PARK_HOLD_MAX_MS * NSEC_PER_MSEC),
+                   dispatch_get_main_queue(), ^{
+        if (pingouin_park_hold && pingouin_park_hold_gen == gen) {
+            pingouin_park_hold_end("no frame in time");
+        }
+    });
+}
+
+/*
+ * Main thread: a guest frame flushed at `flushed` is on the main layer now.
+ * Up: the Mac's cursor shows at once. Back: it hides one refresh later
+ * (Core Animation shows the layer's new contents a refresh after the
+ * cursor's change: hidden now, there was no arrow for that refresh).
+ */
+static void pingouin_park_frame_shown(double flushed)
+{
+    unsigned gen = pingouin_park_hold_gen;
+    NSInteger hz;
+
+    if (!pingouin_park_hold || flushed < pingouin_park_hold_at + pingouin_park_margin()) {
+        return;
+    }
+    if (pingouin_park_hold < 0) {
+        pingouin_park_hold_end("the guest's frame is on screen");
+        return;
+    }
+    hz = [[[cocoaView window] screen] maximumFramesPerSecond];
+    pingouin_park_hold_at = INFINITY;     /* one end only */
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                 (int64_t)(NSEC_PER_SEC / (hz > 0 ? hz : 60))),
+                   dispatch_get_main_queue(), ^{
+        if (pingouin_park_hold && pingouin_park_hold_gen == gen) {
+            pingouin_park_hold_end("the guest's frame is on screen, a refresh later");
+        }
+    });
+}
+
