+- (void)setMarkedText:(id)string selectedRange:(NSRange)selectedRange
+     replacementRange:(NSRange)replacementRange
+{
+    PINGOUIN_IME_TRACE("setMarkedText sel %lu+%lu\n", (unsigned long)selectedRange.location, (unsigned long)selectedRange.length);
+    NSAttributedString *attr = [string isKindOfClass:[NSAttributedString class]] ? string : nil;
+    NSString *s = attr ? [attr string] : string;
+    bool was = pingouin_ime_marked != nil;
+
+    if (![s isKindOfClass:[NSString class]]) {
+        return;
+    }
+    pingouin_ime_set_marked(s);
+    if (![s length]) {
+        if (was) {
+            pingouin_ime_write(@{ @"t": @"cancel" });
+        }
+        return;
+    }
+    if (pingouin_ime_field()) {
+        pingouin_ime_preedit(s, selectedRange, attr);
+    }
+}
+
+- (void)unmarkText
+{
+    PINGOUIN_IME_TRACE("unmarkText\n");
+    /* The input method keeps the marked text as it is. */
+    NSString *s = [[pingouin_ime_marked retain] autorelease];
+
+    pingouin_ime_set_marked(nil);
+    if ([s length] && pingouin_ime_field()) {
+        pingouin_ime_commit(s);
+    }
+}
+
+- (NSRange)selectedRange
+{
+    PINGOUIN_IME_TRACE("selectedRange\n");
+    return NSMakeRange(pingouin_ime_marked ? [pingouin_ime_marked length] : 0, 0);
+}
+
+- (NSRange)markedRange
+{
+    PINGOUIN_IME_TRACE("markedRange\n");
+    return pingouin_ime_marked ? NSMakeRange(0, [pingouin_ime_marked length]) : NSMakeRange(NSNotFound, 0);
+}
+
+- (BOOL)hasMarkedText
+{
+    PINGOUIN_IME_TRACE("hasMarkedText\n");
+    return pingouin_ime_marked != nil;
