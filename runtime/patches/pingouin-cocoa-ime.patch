+- (NSInteger)windowLevel
+{
+    PINGOUIN_IME_TRACE("windowLevel\n");
+    NSWindow *w = pingouin_is_our_window([NSApp keyWindow]) ? [NSApp keyWindow] : [self window];
+    return [w level];
+}
