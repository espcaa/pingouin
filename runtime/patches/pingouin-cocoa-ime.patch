+- (void)doCommandBySelector:(SEL)selector
+{
+    if (pingouin_ime_debug) {
+        fprintf(stderr, "pingouin-ime: command %s\n", [NSStringFromSelector(selector) UTF8String]);
+    }
+    /* Return, Tab, arrows, Backspace with nothing marked: the key itself. */
+    pingouin_ime_send_key();
+}
