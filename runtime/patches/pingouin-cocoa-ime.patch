+- (NSArray<NSAttributedStringKey> *)validAttributesForMarkedText
+{
+    return @[NSMarkedClauseSegmentAttributeName, NSUnderlineStyleAttributeName];
+}
+
+/*
+ * The input method reads back only what it marked itself (Kotoeri needs that
+ * to convert); the guest's own text is never known here, so never read.
+ */
+- (NSAttributedString *)attributedSubstringForProposedRange:(NSRange)range
+                                                actualRange:(NSRangePointer)actualRange
+{
+    PINGOUIN_IME_TRACE("attributedSubstring %lu+%lu\n", (unsigned long)range.location, (unsigned long)range.length);
+    NSRange r;
+
+    if (!pingouin_ime_marked || range.location == NSNotFound) {
+        return nil;
+    }
+    r = NSIntersectionRange(range, NSMakeRange(0, [pingouin_ime_marked length]));
+    if (!r.length && range.location != [pingouin_ime_marked length]) {
+        return nil;
+    }
+    if (actualRange) {
+        *actualRange = r;
+    }
+    return [[[NSAttributedString alloc] initWithString:[pingouin_ime_marked substringWithRange:r]] autorelease];
+}
+
+- (NSUInteger)characterIndexForPoint:(NSPoint)point
+{
+    PINGOUIN_IME_TRACE("characterIndexForPoint\n");
+    return NSNotFound;
+}
+
+- (NSRect)firstRectForCharacterRange:(NSRange)range actualRange:(NSRangePointer)actualRange
+{
+    PINGOUIN_IME_TRACE("firstRect %lu+%lu\n", (unsigned long)range.location, (unsigned long)range.length);
+    if (actualRange) {
+        *actualRange = range;
+    }
+    return pingouin_ime_caret();
+}
