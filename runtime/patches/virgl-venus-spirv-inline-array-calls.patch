diff --git a/src/venus/vkr_spirv_inline.c b/src/venus/vkr_spirv_inline.c
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_spirv_inline.c
@@ -0,0 +1,260 @@
+/*
+ * Copyright 2026 Pingouin contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Pingouin (virgl-venus-spirv-inline-array-calls.patch): see vkr_spirv_inline.h */
+
+#include "vkr_spirv_inline.h"
+
+#include <spirv-tools/libspirv.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+   OP_FUNCTION = 54,
+   OP_FUNCTION_PARAMETER = 55,
+   OP_FUNCTION_END = 56,
+   OP_FUNCTION_CALL = 57,
+};
+
+static bool
+is_array_type(const struct vkr_spirv_info *info, uint32_t id)
+{
+   /* info->types is sorted by id (vkr_spirv_scan) */
+   uint32_t lo = 0, hi = info->type_count;
+   while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      const struct vkr_spirv_type *t = &info->types[mid];
+      if (t->id == id)
+         return t->kind == VKR_SPIRV_TYPE_ARRAY;
+      if (t->id < id)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   return false;
+}
+
+bool
+vkr_spirv_has_array_params(const struct vkr_spirv_info *info, const uint32_t *code, size_t bytes)
+{
+   /* no call, no parameter that matters (an entry point takes none) */
+   if (!info->call_count || !info->type_count)
+      return false;
+   const size_t n = bytes / 4;
+   /* the scan walked the same code: the words are whole instructions; checked anyway */
+   for (size_t i = 5; i < n;) {
+      const uint32_t op = code[i] & 0xffff, len = code[i] >> 16;
+      if (!len || len > n - i)
+         return false;
+      if (op == OP_FUNCTION_PARAMETER && len >= 3 && is_array_type(info, code[i + 1]))
+         return true;
+      i += len;
+   }
+   return false;
+}
+
+static inline uint64_t
+min_u64(uint64_t a, uint64_t b)
+{
+   return a < b ? a : b;
+}
+
+struct fn_id {
+   uint32_t id, index;
+};
+
+static int
+cmp_fn_id(const void *a, const void *b)
+{
+   const uint32_t x = ((const struct fn_id *)a)->id, y = ((const struct fn_id *)b)->id;
+   return x < y ? -1 : x > y;
+}
+
+/* the index of function `id`, or UINT32_MAX */
+static uint32_t
+fn_index(const struct fn_id *ids, uint32_t n, uint32_t id)
+{
+   uint32_t lo = 0, hi = n;
+   while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      if (ids[mid].id == id)
+         return ids[mid].index;
+      if (ids[mid].id < id)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   return UINT32_MAX;
+}
+
+bool
+vkr_spirv_inline_size_ok(const struct vkr_spirv_info *info,
+                         const uint32_t *code,
+                         size_t bytes,
+                         uint64_t max_bytes,
+                         uint64_t *estimate_bytes)
+{
+   *estimate_bytes = UINT64_MAX;
+   const size_t n = bytes / 4;
+   if (n < 5)
+      return false;
+   /* past the cap every size is cap: no overflow, and the answer is the same */
+   const uint64_t cap = max_bytes / 4 + 1;
+   /* first walk: functions and calls (each a word index bound, so the arrays fit) */
+   uint32_t nf = 0, nc = 0;
+   for (size_t i = 5; i < n;) {
+      const uint32_t op = code[i] & 0xffff, len = code[i] >> 16;
+      if (!len || len > n - i)
+         return false;
+      nf += op == OP_FUNCTION;
+      nc += op == OP_FUNCTION_CALL;
+      i += len;
+   }
+   if (!nf)
+      return false;
+   uint64_t *own = calloc(nf, sizeof(*own));
+   uint64_t *size = calloc(nf, sizeof(*size));
+   struct fn_id *ids = calloc(nf, sizeof(*ids));
+   uint32_t *call_from = calloc(nc + 1, sizeof(*call_from));
+   uint32_t *call_to = calloc(nc + 1, sizeof(*call_to));
+   uint32_t *start = calloc(nf + 1, sizeof(*start)); /* calls of function f: [start[f], start[f+1]) */
+   uint32_t *callee = calloc(nc + 1, sizeof(*callee));
+   uint32_t *stack = calloc(nf, sizeof(*stack));
+   uint32_t *pos = calloc(nf, sizeof(*pos));
+   uint8_t *state = calloc(nf, 1); /* 0 not seen, 1 open, 2 done */
+   bool ok = own && size && ids && call_from && call_to && start && callee && stack && pos && state;
+   uint64_t outside = 0;
+   /* second walk: each function's own words, each call's caller and callee id */
+   uint32_t f = UINT32_MAX, fi = 0, ci = 0;
+   for (size_t i = 5; ok && i < n;) {
+      const uint32_t op = code[i] & 0xffff, len = code[i] >> 16;
+      if (op == OP_FUNCTION) {
+         if (len < 5 || f != UINT32_MAX) {
+            ok = false;
+            break;
+         }
+         f = fi++;
+         ids[f] = (struct fn_id){ code[i + 2], f };
+      }
+      if (f == UINT32_MAX) {
+         outside += len;
+      } else {
+         own[f] += len;
+         if (op == OP_FUNCTION_CALL) {
+            if (len < 4) {
+               ok = false;
+               break;
+            }
+            call_from[ci] = f;
+            call_to[ci++] = code[i + 3];
+         }
+      }
+      if (op == OP_FUNCTION_END)
+         f = UINT32_MAX;
+      i += len;
+   }
+   if (ok) {
+      qsort(ids, nf, sizeof(*ids), cmp_fn_id);
+      /* calls by caller (counting sort), their callees by index */
+      for (uint32_t c = 0; c < nc; c++)
+         start[call_from[c] + 1]++;
+      for (uint32_t g = 0; g < nf; g++)
+         start[g + 1] += start[g];
+      memcpy(pos, start, nf * sizeof(*pos));
+      for (uint32_t c = 0; ok && c < nc; c++) {
+         const uint32_t to = fn_index(ids, nf, call_to[c]);
+         ok = to != UINT32_MAX;
+         callee[pos[call_from[c]]++] = to;
+      }
+   }
+   /* each function's inlined size, callees first (an explicit stack: no recursion) */
+   for (uint32_t root = 0; ok && root < nf; root++) {
+      if (state[root])
+         continue;
+      uint32_t sp = 0;
+      stack[sp++] = root;
+      while (ok && sp) {
+         const uint32_t g = stack[sp - 1];
+         if (!state[g]) {
+            state[g] = 1;
+            pos[g] = start[g];
+            size[g] = min_u64(own[g], cap);
+         }
+         if (pos[g] < start[g + 1]) {
+            const uint32_t h = callee[pos[g]];
+            if (state[h] == 1) {
+               ok = false; /* a cycle: recursion, which SPIR-V for Vulkan has none of */
+            } else if (!state[h]) {
+               stack[sp++] = h; /* each function is pushed once: sp <= nf */
+            } else {
+               size[g] = min_u64(size[g] + size[h], cap);
+               pos[g]++;
+            }
+         } else {
+            state[g] = 2;
+            sp--;
+         }
+      }
+   }
+   /* the entry points' functions with their callees inside, and the rest of the module */
+   uint64_t total = min_u64(outside, cap);
+   for (uint32_t e = 0; ok && e < info->entry_count; e++) {
+      const uint32_t g = fn_index(ids, nf, info->entries[e].function);
+      ok = g != UINT32_MAX;
+      if (ok)
+         total = min_u64(total + size[g], cap);
+   }
+   free(own);
+   free(size);
+   free(ids);
+   free(call_from);
+   free(call_to);
+   free(start);
+   free(callee);
+   free(stack);
+   free(pos);
+   free(state);
+   if (!ok)
+      return false;
+   *estimate_bytes = total * 4;
+   return total < cap;
+}
+
+uint32_t *
+vkr_spirv_inline_calls(uint32_t env,
+                       const uint32_t *code,
+                       size_t bytes,
+                       size_t *out_bytes,
+                       char *why,
+                       size_t why_size)
+{
+   /* merge-return first: the inliner leaves a function with an early return where it is */
+   static const char *const flags[] = {
+      "--merge-return",
+      "--inline-entry-points-exhaustive",
+      "--eliminate-dead-functions",
+   };
+   spv_binary out = NULL;
+   const spv_result_t r =
+      pingouinOptimizeWithFlags((spv_target_env)env, flags, sizeof(flags) / sizeof(flags[0]),
+                                VKR_SPIRV_MAX_BOUND, code, bytes / 4, &out);
+   if (r != SPV_SUCCESS || !out) {
+      snprintf(why, why_size, "spirv-opt's inliner failed (%d%s)", r,
+               r == SPV_ERROR_INTERNAL ? ": a pass failed, ids past the bound or an exception" : "");
+      return NULL;
+   }
+   const size_t size = out->wordCount * sizeof(uint32_t);
+   uint32_t *copy = malloc(size ? size : 4);
+   if (!copy) {
+      spvBinaryDestroy(out);
+      snprintf(why, why_size, "out of host memory");
+      return NULL;
+   }
+   memcpy(copy, out->code, size);
+   spvBinaryDestroy(out);
+   *out_bytes = size;
+   return copy;
+}
diff --git a/src/venus/vkr_spirv_inline.h b/src/venus/vkr_spirv_inline.h
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_spirv_inline.h
@@ -0,0 +1,63 @@
+/*
+ * Copyright 2026 Pingouin contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Pingouin (virgl-venus-spirv-inline-array-calls.patch): guest SPIR-V whose functions take
+ * an array by value has its calls inlined into its entry points before the Mac's driver
+ * reads it. MoltenVK's SPIRV-Cross (MoltenVK 1.4.2) declares such a parameter as
+ * spvUnsafeArray<T, N> but passes a plain T[N] when the argument comes straight out of a
+ * buffer's struct, and Metal's compiler refuses the call ("no matching function"): the
+ * pipeline fails (VK_ERROR_INITIALIZATION_FAILED) and the guest, which made it without
+ * waiting, binds a pipeline vkr never had. naga (wgpu) writes such functions (Zed 1.27.0's
+ * vs_quad and fs_path_rasterization). Inlined, no function takes an array and SPIRV-Cross
+ * writes no such call. Only modules with an array parameter are touched. Self-contained but
+ * for SPIRV-Tools' C API (pingouinOptimizeWithFlags, spirv-tools-opt-catch-throws.patch), so
+ * it is tested on the CPU alone (Tests/virgl/test-venus-spirv-validate.sh). */
+
+#ifndef VKR_SPIRV_INLINE_H
+#define VKR_SPIRV_INLINE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "vkr_spirv.h"
+
+/* true when a function of the module (its `bytes` bytes of code, scanned as `info`) takes
+ * an array by value (an OpFunctionParameter of an OpTypeArray type) */
+bool
+vkr_spirv_has_array_params(const struct vkr_spirv_info *info, const uint32_t *code, size_t bytes);
+
+/* the most bytes an inlined module may take: 16 times the largest real module seen (67 KB);
+ * Zed's inline to 21-22 KB */
+#define VKR_SPIRV_INLINE_MAX_BYTES (1u << 20)
+
+/* before the optimizer runs: an estimate of the module's size once every call is inlined
+ * into its entry points (each function's own words, plus its callees' inlined size once per
+ * call, plus the words outside functions; merge-return adds a little: Zed's came out within
+ * 1%) in *estimate_bytes; false when it is past
+ * max_bytes (the inliner would grow without bound: a function calling another twice, 20
+ * levels deep, is 2^20 copies), when the call graph is not acyclic or out of host memory.
+ * Linear in the module's size, no recursion (the ring thread's stack). */
+bool
+vkr_spirv_inline_size_ok(const struct vkr_spirv_info *info,
+                         const uint32_t *code,
+                         size_t bytes,
+                         uint64_t max_bytes,
+                         uint64_t *estimate_bytes);
+
+/* the module with its function calls inlined into its entry points (spirv-opt's
+ * --merge-return --inline-entry-points-exhaustive --eliminate-dead-functions for target env
+ * `env`, a spv_target_env, ids capped at VKR_SPIRV_MAX_BOUND): malloc'd code (free() it) and
+ * its size in *out_bytes, or NULL with the reason in why. The result is not validated: the
+ * caller scans and validates it as it does the guest's code. */
+uint32_t *
+vkr_spirv_inline_calls(uint32_t env,
+                       const uint32_t *code,
+                       size_t bytes,
+                       size_t *out_bytes,
+                       char *why,
+                       size_t why_size);
+
+#endif /* VKR_SPIRV_INLINE_H */
