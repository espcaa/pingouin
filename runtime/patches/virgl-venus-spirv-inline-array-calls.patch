+   /* a callee's Function variables are one copy per call once inlined: an entry point the
+    * guest's code kept inside the cap (default sizes, as at vkCreateShaderModule) must stay
+    * inside it, or the pipeline check would refuse what worked before */
+   const bool by_interface = target->options & VKR_SPIRV_INTERFACE_GLOBALS;
+   for (uint32_t e = 0; ok && e < scan->entry_count; e++) {
+      uint64_t before = 0, after = 0;
+      const struct vkr_spirv_entry *was =
+         vkr_spirv_entry(*spirv, scan->names + scan->entries[e].name, scan->entries[e].model);
+      const bool counted_before =
