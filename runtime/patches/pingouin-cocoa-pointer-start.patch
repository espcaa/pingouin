+    pingouin_guard.follow = !pingouin_mac_cursor_hidden;
     pingouin_guard_event(&pingouin_guard, &s, [event timestamp], loc.x, loc.y,
                        dx, dy, cur.x, cur.y, &st);
     pingouin_guard_apply(&st);
@@ -5725,6 +5856,12 @@ static void pingouin_chan_line(NSData *data)
         NSDictionary *d = obj;
         bool update = false;
         if (d[@"hello"]) {
+            if (!pingouin_ptr.drawing) {
+                info_report("cocoa: the guest draws its own pointer now");
+            }
+            pingouin_pointer_guest_hello(&pingouin_ptr);
+            [cocoaView pingouinUpdateMacCursor];
+            [cocoaView pingouinTakePointer:nil why:"guest pointer up"];
             pingouin_guest_ready = true;
