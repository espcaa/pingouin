-- (void) hideCursor
+/*
+ * Pingouin: the Mac's cursor over the VM, hidden or shown from one place
+ * (ui/pingouin-pointer-start.h says when). [NSCursor hide] counts: a second
+ * grab without a let-go between (full screen) hid it twice, and one unhide
+ * then left it hidden.
+ */
+- (void) pingouinUpdateMacCursor
 {
-    if (!cursor_hide) {
+    bool hide = pingouin_pointer_hide_mac(&pingouin_ptr, cursor_hide, isMouseGrabbed,
+                                        isAbsoluteEnabled);
+
+    if (hide == pingouin_mac_cursor_hidden) {
         return;
     }
-    [NSCursor hide];
+    pingouin_mac_cursor_hidden = hide;
+    if (pingouin_pointer_debug) {
+        info_report("pingouin-pointer: Mac cursor %s", hide ? "hidden" : "shown");
+    }
+    if (pingouin_test_pointer) {
+        return;     /* test: never the real cursor (the user works meanwhile) */
+    }
+    if (hide) {
+        [NSCursor hide];
+    } else {
+        [NSCursor unhide];
+    }
 }
 
-- (void) unhideCursor
+/* Pingouin: the pointer is on the VM's picture (this view), nothing above it. */
+- (bool) pingouinPointerOver:(NSEvent *)event
 {
-    if (!cursor_hide) {
+    NSWindow *w = [self window];
+    NSPoint p;
+
+    if (!w || ![w isVisible] ||
+        !([w occlusionState] & NSWindowOcclusionStateVisible)) {
+        return false;
+    }
+    if (event && [event window] == w) {
+        p = [self convertPoint:[event locationInWindow] fromView:nil];
+    } else {
+        p = [self convertPoint:[w convertPointFromScreen:[NSEvent mouseLocation]]
+                      fromView:nil];
+    }
+    if (!NSPointInRect(p, [self visibleRect])) {
+        return false;
+    }
+    /* Test: the motion is made up; the real cursor is elsewhere. */
+    return pingouin_test_pointer ||
+           [NSWindow windowNumberAtPoint:[NSEvent mouseLocation]
+             belowWindowWithWindowNumber:0] == [w windowNumber];
+}
+
+/*
+ * Pingouin: take the pointer without a click (ui/pingouin-pointer-start.h): on
+ * the first motion over the VM, or event nil: now (the window became key,
+ * the app active, full screen, the guest's pointer came up), when the
+ * pointer is on the VM.
+ */
+- (void) pingouinTakePointer:(NSEvent *)event why:(const char *)why
+{
+    PingouinPointerIn in = {
+        .absolute = isAbsoluteEnabled,
+        .grabbed = isMouseGrabbed,
+        .active = pingouin_test_pointer || [NSApp isActive],
+        .key = pingouin_test_pointer || pingouin_is_our_window([NSApp keyWindow]),
+        .over = [self pingouinPointerOver:event],
+        .buttons = !pingouin_test_pointer && [NSEvent pressedMouseButtons] != 0,
+    };
+
+    if (pingouin_pointer_take(&pingouin_ptr, &in)) {
+        if (pingouin_pointer_debug) {
+            info_report("pingouin-pointer: taken (%s)", why);
+        }
+        [self grabMouse];
+    }
+}
+
+- (void) pingouinFullScreenTake
+{
+    if (isMouseGrabbed) {
+        return;
+    }
+    /*
+     * full-screen=on comes before the first look at the pointer's mode: a
+     * relative grab then (the Mac's cursor held and hidden) until it
+     * turned out absolute a moment later.
+     */
+    [self notifyMouseModeChange];
+    if (isMouseGrabbed) {
         return;
     }
-    [NSCursor unhide];
+    if (pingouin_ptr.off || !isAbsoluteEnabled) {
+        [self grabMouse];       /* as upstream */
+        return;
+    }
+    [self pingouinTakePointer:nil why:"full screen"];
 }
 
