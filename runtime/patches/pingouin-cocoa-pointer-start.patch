             pingouin_last_layout = nil;
@@ -5823,6 +5960,73 @@ static void pingouin_chan_connect(void)
     dispatch_resume(pingouin_chan_src);
 }
 
+/* A guest reset (QEMU's thread, BQL): its firmware and boot draw no pointer. */
+static void pingouin_pointer_reset(void *opaque)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        pingouin_pointer_guest_reset(&pingouin_ptr);
+        [cocoaView pingouinUpdateMacCursor];
+    });
+}
+
+/*
+ * Test (PINGOUIN_TEST_POINTER=<seconds>, test mode only): made-up motion over
+ * the main view four times a second, from the start, through AppKit's
+ * entry for it (mouseMoved:), as if the user moved the mouse and never
+ * clicked. Never the real cursor: the window counts as key and in front,
+ * the guard is off for it, and the Mac's cursor is only logged.
+ */
+static void pingouin_test_motion(int tick, int ticks)
+{
+    NSWindow *w = [cocoaView window];
+    NSRect b = [cocoaView bounds];
+    double t = tick * 0.35;
+    NSPoint p;
+    NSEvent *e;
+
+    if (tick >= ticks) {
+        info_report("pingouin-pointer: test motion done (%d moves)", ticks);
+        return;
+    }
+    p = NSMakePoint(NSMidX(b) + cos(t) * b.size.width / 4,
+                    NSMidY(b) + sin(t) * b.size.height / 4);
+    e = [NSEvent mouseEventWithType:NSEventTypeMouseMoved
+                           location:[cocoaView convertPoint:p toView:nil]
+                      modifierFlags:0
+                          timestamp:[[NSProcessInfo processInfo] systemUptime]
+                       windowNumber:[w windowNumber]
+                            context:nil
+                        eventNumber:0
+                         clickCount:0
+                           pressure:0];
+    if (e && [w isVisible]) {
+        [cocoaView mouseMoved:e];
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 4),
+                   dispatch_get_main_queue(), ^{ pingouin_test_motion(tick + 1, ticks); });
+}
+
+/* Main thread, with the BQL (from pingouin_displays_init). */
+static void pingouin_pointer_init(void)
+{
+    const char *v = getenv("PINGOUIN_POINTER_START");
+    const char *test = getenv("PINGOUIN_TEST_POINTER");
+
+    pingouin_ptr.off = v && !strcmp(v, "0");
+    pingouin_test_pointer = test && atoi(test) > 0 && pingouin_test_mode();
+    pingouin_pointer_debug = pingouin_test_pointer ||
+                           (getenv("PINGOUIN_POINTER_DEBUG") &&
+                            !strcmp(getenv("PINGOUIN_POINTER_DEBUG"), "1"));
+    qemu_register_reset(pingouin_pointer_reset, NULL);
+    info_report("cocoa: pointer: %s", pingouin_ptr.off ?
+                "taken on enter or click (PINGOUIN_POINTER_START=0)" :
+                "taken without a click when it is on the VM");
+    if (pingouin_test_pointer) {
+        int ticks = atoi(test) * 4;
+        dispatch_async(dispatch_get_main_queue(), ^{ pingouin_test_motion(0, ticks); });
+    }
+}
+
 /* Main thread, with the BQL (from cocoa_display_init). */
 static void pingouin_displays_init(void)
 {
@@ -5868,10 +6072,19 @@ static void pingouin_displays_init(void)
                     object:nil
                      queue:[NSOperationQueue mainQueue]
                 usingBlock:^(NSNotification *note) {
+        pingouin_pointer_left(&pingouin_ptr);
         if ([cocoaView isMouseGrabbed]) {
             [cocoaView ungrabMouse];
         }
     }];
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName:NSApplicationDidBecomeActiveNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        [cocoaView pingouinTakePointer:nil why:"app active"];
+    }];
+    pingouin_pointer_init();
     pingouin_update_mac_layout();
     pingouin_chan_connect();
 }
