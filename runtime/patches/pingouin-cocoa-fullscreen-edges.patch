+/*
+ * While the VM has the pointer in full screen, the Mac's cursor never reaches
+ * a corner of its display (a macOS hot corner: one put the Mac's display to
+ * sleep from inside the VM) nor the Dock's edge (on another display than the
+ * main window's the Dock came up there). Moving the cursor back after it got
+ * there is too late, so within 200 points of a corner or the Dock's edge the
+ * cursor is detached from the mouse and stays where it is, and the guest's
+ * pointer moves on by the mouse's motion: the same motion macOS moves the
+ * cursor by, so it feels the same there. The maths is in
+ * ui/pingouin-pointer-guard.h. Edges shared with another display stay open.
+ * Off with immersive=off; leaving the zone, our windows, full screen, the
+ * Space or the VM gives the cursor back where the pointer is.
+ */
+/*
+ * The guard's place as a point in one of our views: 1. 0: this event has its
+ * own place. -1: the guard has the place but it is in none of our windows;
+ * the caller sends no position (the event's location is the held cursor's,
+ * up to 200 points off). Membership is tested in CoreGraphics' space the way
+ * the guard tests it, so the window's top row (where the guard stops the
+ * pointer) counts.
+ */
+static int pingouin_guarded_target(NSView **view, int *output, NSPoint *p)
+{
+    double wx, wy;
+    int i, o;
+
+    if (!pingouin_guard_place) {
+        return 0;
+    }
+    i = pingouin_guard_window_point(&pingouin_guard_scr, pingouin_guard.x,
+                                  pingouin_guard.y, &wx, &wy);
+    o = i < 0 ? -1 : pingouin_guard_ours_output[i];
+    if (o >= 0 && o < pingouin_outputs) {
+        NSView *v = o ? pingouin_heads[o].view : cocoaView;
+
+        if (v) {
+            *view = v;
+            *output = o;
+            *p = [v convertPoint:NSMakePoint(wx, wy) fromView:nil];
+            return 1;
+        }
+    }
+    return -1;
+}
+
+static void pingouin_guard_apply(const PingouinGuardStep *st)
+{
+    if (st->warp) {
+        CGWarpMouseCursorPosition(CGPointMake(st->wx, st->wy));
+    }
+    if (st->detach) {
+        /* Without this the cursor stalls for a moment after a warp. */
+        CGEventSourceRef src = CGEventSourceCreate(kCGEventSourceStateCombinedSessionState);
+        if (src) {
+            CGEventSourceSetLocalEventsSuppressionInterval(src, 0);
+            CFRelease(src);
+        }
+        CGAssociateMouseAndMouseCursorPosition(false);
+    }
+    if (st->attach) {
+        CGAssociateMouseAndMouseCursorPosition(true);
+    }
+}
+
+/*
+ * The Mac's displays and our visible windows (CoreGraphics' space) into
+ * pingouin_guard_scr, with the output each window shows.
+ */
+static void pingouin_guard_screens(void)
+{
+    PingouinGuardScreens *s = &pingouin_guard_scr;
+    CGDirectDisplayID ids[16];
+    uint32_t n = 0;
+    CGFloat top = NSMaxY([[[NSScreen screens] firstObject] frame]);
+
+    memset(s, 0, sizeof(*s));
+    if (CGGetActiveDisplayList(16, ids, &n) != kCGErrorSuccess) {
+        n = 0;
+    }
+    for (uint32_t i = 0; i < n && s->ndisplays < 16; i++) {
+        CGRect r = CGDisplayBounds(ids[i]);
+        pingouin_guard_displays[s->ndisplays++] =
+            (PingouinRect){ r.origin.x, r.origin.y, r.size.width, r.size.height };
+    }
+    for (int i = 0; i < pingouin_outputs && s->nours < PINGOUIN_MAX_OUTPUTS; i++) {
+        NSWindow *w = i ? pingouin_heads[i].window : [cocoaView window];
+        NSRect f;
+
+        if (!w || ![w isVisible] ||
+            !([w occlusionState] & NSWindowOcclusionStateVisible)) {
+            continue;
+        }
+        f = [w frame];
+        pingouin_guard_ours_output[s->nours] = i;
+        pingouin_guard_ours_rects[s->nours++] =
+            pingouin_guard_rect_from_cocoa(top, f.origin.x, f.origin.y,
+                                         f.size.width, f.size.height);
+    }
+    s->displays = pingouin_guard_displays;
+    s->ours = pingouin_guard_ours_rects;
+    s->dock_edge = pingouin_dock_edge();
+}
+
+static void pingouin_corner_release(void)
+{
+    PingouinGuardStep st;
+
+    pingouin_guard_place = false;
+    if (!pingouin_guard.held) {
+        return;
+    }
+    pingouin_guard_screens();
+    memset(&st, 0, sizeof(st));
+    pingouin_guard_release(&pingouin_guard, &pingouin_guard_scr, &st);
+    pingouin_guard_apply(&st);
+}
+
+/* The edge the Dock sits on (read again on each full screen). */
+static int pingouin_dock_edge(void)
+{
+    if (pingouin_dock_edge_cache < 0) {
+        CFPropertyListRef v = CFPreferencesCopyAppValue(CFSTR("orientation"),
+                                                        CFSTR("com.apple.dock"));
+        pingouin_dock_edge_cache = PINGOUIN_DOCK_BOTTOM;
+        if (v && CFGetTypeID(v) == CFStringGetTypeID()) {
+            if (CFStringCompare((CFStringRef)v, CFSTR("left"), 0) == kCFCompareEqualTo) {
+                pingouin_dock_edge_cache = PINGOUIN_DOCK_LEFT;
+            } else if (CFStringCompare((CFStringRef)v, CFSTR("right"), 0) == kCFCompareEqualTo) {
+                pingouin_dock_edge_cache = PINGOUIN_DOCK_RIGHT;
+            }
+        }
+        if (v) {
+            CFRelease(v);
+        }
+    }
+    return pingouin_dock_edge_cache;
+}
+
+static void pingouin_guard_corners(NSEvent *event)
+{
+    PingouinGuardStep st;
+    PingouinGuardScreens s;
+    CGEventRef cg = [event CGEvent], now;
+    CGPoint loc, cur;
+    double dx = 0, dy = 0;
+    bool on = immersive_mode_enabled && pingouin_main_full_screen();
+
+    pingouin_guard_place = false;
+    if (!on) {
+        pingouin_corner_release();
+        /* Events queued before the let-go still get the pointer's place. */
+        if (!pingouin_guard.let_go) {
+            return;
+        }
+    }
+    switch ([event type]) {
+    case NSEventTypeMouseMoved:
+    case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDragged:
+    case NSEventTypeOtherMouseDragged:
+        /* macOS's motion after its acceleration, in points (the cursor's own). */
+        dx = [event deltaX];
+        dy = [event deltaY];
+        break;
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown:
+    case NSEventTypeOtherMouseUp:
+        break;
+    default:
+        /* Entered and the like: AppKit's, made from a motion the guard saw. */
+        pingouin_guard_place = pingouin_guard.held;
+        return;
+    }
+    now = CGEventCreate(NULL);
+    if (!cg || !now) {
+        if (now) {
+            CFRelease(now);
+        }
+        pingouin_guard_place = pingouin_guard.held;
+        return;
+    }
+    cur = CGEventGetLocation(now);
+    CFRelease(now);
+    loc = CGEventGetLocation(cg);
+    pingouin_guard_screens();
+    s = pingouin_guard_scr;
+    if (!on) {
+        s.nours = 0;    /* never takes hold */
+    }
+    /* The Mac's cursor is the only pointer shown (show-cursor=on): it follows. */
+    pingouin_guard.follow = !cursor_hide;
+    pingouin_guard_event(&pingouin_guard, &s, [event timestamp], loc.x, loc.y,
+                       dx, dy, cur.x, cur.y, &st);
+    pingouin_guard_apply(&st);
+    pingouin_guard_place = st.place;
+    if (st.let_go_out && getenv("PINGOUIN_POINTER_DEBUG") &&
+        !strcmp(getenv("PINGOUIN_POINTER_DEBUG"), "1")) {
+        info_report("pingouin-pointer: guard: let-go warp taken out of a motion "
+                    "(%.1f,%.1f)", st.ldx, st.ldy);
+    }
+}
