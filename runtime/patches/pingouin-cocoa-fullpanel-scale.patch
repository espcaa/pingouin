+/*
+ * FullPanel (#355): the scale the guest wants ({"scale": s}, the display
+ * agent's, from Omarchy's own setting). Kept in the VM's folder for the
+ * next start; in FullPanel the guest gets a size that fits it at once.
+ * Main thread. The guest's number is checked (1 to 4, Hyprland's steps).
+ */
+static void pingouin_fp_scale_from_guest(double s)
+{
+    uint32_t k = pingouin_fp_scale_k(s);
+    const char *file = getenv("PINGOUIN_FULLPANEL_SCALE_FILE");
+
+    pingouin_fp_scale_load();
+    if (!k || k == qatomic_read(&pingouin_fp_scale_want)) {
+        return;
+    }
+    qatomic_set(&pingouin_fp_scale_want, k);
+    if (file && *file) {
+        char tmp[PATH_MAX];
+        if (snprintf(tmp, sizeof(tmp), "%s.new", file) < (int)sizeof(tmp)) {
+            FILE *f = fopen(tmp, "w");
+            if (f) {
+                fprintf(f, "%u\n", k);
+                if (fclose(f) == 0) {
+                    rename(tmp, file);
+                }
+            }
+        }
+    }
+    fprintf(stderr, "pingouin: full panel: the guest's scale is %.2f now\n", k / 120.0);
+    if (pingouin_fullpanel_window_usable([cocoaView window]) &&
+        ([[cocoaView window] styleMask] & NSWindowStyleMaskFullScreen)) {
+        [cocoaView updateUIInfo];
+    }
+}
+
+/* The scale kept for the VM (PINGOUIN_FULLPANEL_SCALE_FILE), read once. */
+static void pingouin_fp_scale_load(void)
+{
+    static bool loaded;
+    const char *file = getenv("PINGOUIN_FULLPANEL_SCALE_FILE");
+    unsigned k = 0;
+
+    if (loaded) {
+        return;
+    }
+    loaded = true;
+    FILE *f = file && *file ? fopen(file, "r") : NULL;
+    if (!f) {
+        return;
+    }
+    if (fscanf(f, "%u", &k) == 1 && k >= PINGOUIN_FP_SCALE_MIN && k <= PINGOUIN_FP_SCALE_MAX) {
+        qatomic_set(&pingouin_fp_scale_want, k);
+    }
+    fclose(f);
 }
 
