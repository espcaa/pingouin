+static PingouinHeadDelegate *pingouin_head_delegate;
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+
+/*
+ * Tells the guest each output's size, scale and refresh rate, or that it is
+ * off: all in one go. The guest reads all outputs on one display event, and
+ * clears that event when done; a second event during its read would be lost.
+ */
+static void pingouin_heads_ui_info(void)
+{
+    QemuUIInfo infos[PINGOUIN_MAX_OUTPUTS];
+    uint32_t refresh[PINGOUIN_MAX_OUTPUTS];
+    QemuUIInfo *pinfos = infos;       /* blocks cannot capture arrays */
+    uint32_t *prefresh = refresh;     /* (with_bql runs the block right away) */
+
+    memset(infos, 0, sizeof(infos));
+    memset(refresh, 0, sizeof(refresh));
+    for (int i = 1; i < pingouin_outputs; i++) {
+        PingouinHead *hd = &pingouin_heads[i];
+        NSScreen *s = hd->display ? pingouin_screen_with_id(hd->display) : nil;
+        QemuUIInfo *info = &infos[i];
+
+        if (!s) {
+            continue;
+        }
+        PingouinBox b = pingouin_head_box(hd, s);
+        CGFloat k = [s backingScaleFactor];
+        CVDisplayLinkRef link;
+        uint32_t div = k > 1.75 ? 2 : k > 1.25 ? 3 : 1;
+
+        if (!CVDisplayLinkCreateWithCGDisplay(hd->display, &link)) {
+            CVTime period = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link);
+            CVDisplayLinkRelease(link);
+            if (!(period.flags & kCVTimeIsIndefinite) &&
+                period.timeValue > 0 && period.timeScale > 0) {
+                refresh[i] = (int64_t)1000 * period.timeScale / period.timeValue;
+            }
+        }
+        if (!refresh[i] && [s maximumFramesPerSecond] > 0) {
+            refresh[i] = (uint32_t)[s maximumFramesPerSecond] * 1000;
+        }
+        info->refresh_rate = refresh[i];
+        /* Same density rule as the main window: 110 points per inch. */
+        info->width_mm = 10 * MIN(255, MAX(1, (int)lround(b.w * 2.54 / 110.0)));
+        info->height_mm = 10 * MIN(255, MAX(1, (int)lround(b.h * 2.54 / 110.0)));
+        info->width = MAX(div, (uint32_t)(b.w * k) / div * div);
+        info->height = MAX(div, (uint32_t)(b.h * k) / div * div);
+    }
+    with_bql(^{
+        for (int i = 1; i < pingouin_outputs; i++) {
+            if (prefresh[i]) {
+                qemu_console_listener_set_refresh(&pingouin_heads[i].dcl,
+                                                  MAX(1u, 1000000u / prefresh[i]));
+            }
+            qemu_console_set_ui_info(pingouin_heads[i].dcl.con, &pinfos[i], false);
+        }
+    });
+}
+
+#pragma clang diagnostic pop
+
+static void pingouin_head_on(PingouinHead *hd, NSScreen *s)
+{
+    NSRect frame = [s frame];
+    NSString *title = [NSString stringWithFormat:@"%@ (display %d)",
+                       pingouin_product_name(), hd->output + 1];
+
+    hd->display = pingouin_screen_id(s);
+    if (!hd->window) {
+        NSRect content = NSMakeRect(0, 0, 640, 400);
+        hd->view = [[PingouinHeadView alloc] initWithFrame:content output:hd->output];
+        hd->window = [[PingouinHeadWindow alloc]
+            initWithContentRect:content
+                      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskResizable
+                        backing:NSBackingStoreBuffered
+                          defer:NO];
+        [hd->window setReleasedWhenClosed:NO];
+        [hd->window setAcceptsMouseMovedEvents:YES];
+        [hd->window setCollectionBehavior:NSWindowCollectionBehaviorFullScreenPrimary];
+        [hd->window setContentView:hd->view];
+        [hd->window setBackgroundColor:[NSColor blackColor]];
+        [hd->window setDelegate:pingouin_head_delegate];
+    }
+    [hd->window setTitle:title];
+    if (pingouin_test_mode()) {
+        /* Borderless over the display, below the notch: no Space, no focus. */
+        NSEdgeInsets in = [s safeAreaInsets];
+        NSRect r = NSMakeRect(frame.origin.x + in.left, frame.origin.y + in.bottom,
+                              frame.size.width - in.left - in.right,
+                              frame.size.height - in.top - in.bottom);
+        [hd->window setStyleMask:NSWindowStyleMaskBorderless];
+        [hd->window setFrame:r display:YES];
+        [hd->window orderFront:nil];
+        hd->want_full = false;
+    } else {
+        [hd->window setFrame:NSInsetRect([s visibleFrame], 60, 60) display:NO];
+        [hd->window orderFront:nil];
+        hd->want_full = true;
+        hd->full_tries = 0;
+    }
+    [[hd->view layer] setContentsScale:[s backingScaleFactor]];
+    hd->dirty = true;
+}
+
+static void pingouin_head_off(PingouinHead *hd)
+{
+    if (pingouin_full_busy && pingouin_full_busy_output == hd->output) {
+        pingouin_full_busy = false;   /* its window goes: do not wait for it */
+    }
+    hd->display = 0;
+    hd->want_full = false;
+    hd->full = false;
+    if (hd->window) {
+        [hd->window orderOut:nil];
+        [hd->window setDelegate:nil];
+        [hd->window close];
+        [hd->window release];
+        hd->window = nil;
+        [hd->view release];
+        hd->view = nil;
+    }
+}
+
+/* macOS full screen, one window at a time: it ignores a second while one is moving. */
+static void pingouin_full_next(void)
+{
+    if (pingouin_full_busy) {
+        return;
+    }
+    for (int i = 1; i < pingouin_outputs; i++) {
+        PingouinHead *hd = &pingouin_heads[i];
+        if (!hd->window || !hd->want_full || hd->full) {
+            continue;
+        }
+        if ([hd->window styleMask] & NSWindowStyleMaskFullScreen) {
+            hd->full = true;
+            hd->want_full = false;
+            continue;
+        }
+        if (++hd->full_tries > 5) {
+            hd->want_full = false;
+            continue;
+        }
+        pingouin_full_busy = true;
+        pingouin_full_busy_output = i;
+        [hd->window toggleFullScreen:nil];
+        int output = i;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC),
+                       dispatch_get_main_queue(), ^{
+            /* No word from macOS: try again (or the next one). */
+            if (pingouin_full_busy && pingouin_full_busy_output == output) {
+                pingouin_full_busy = false;
+                pingouin_full_next();
+            }
+        });
+        return;
+    }
+}
+
+/*
+ * Which Mac displays get a window: in full screen, with the guest's consent,
+ * every display but the main window's. Outputs keep their display while it
+ * stays; new displays take the lowest free output, left to right.
+ */
+static void pingouin_displays_update(void)
+{
+    NSWindow *mw = [cocoaView window];
+    NSScreen *ms = [mw screen];
+    CGDirectDisplayID main_id = ms ? pingouin_screen_id(ms) : 0;
+    bool want = pingouin_outputs > 1 && pingouin_guest_ready &&
+                pingouin_external_enabled && pingouin_main_full_screen() && ms;
+    NSMutableArray *screens = [NSMutableArray array];
+
+    if (want) {
+        for (NSScreen *s in [NSScreen screens]) {
+            CGDirectDisplayID id = pingouin_screen_id(s);
+            if (id != main_id && pingouin_test_allows(id)) {
+                [screens addObject:s];
+            }
+        }
+        [screens sortUsingComparator:^NSComparisonResult(NSScreen *a, NSScreen *b) {
+            CGRect ra = CGDisplayBounds(pingouin_screen_id(a));
+            CGRect rb = CGDisplayBounds(pingouin_screen_id(b));
+            if (ra.origin.x != rb.origin.x) {
+                return ra.origin.x < rb.origin.x ? NSOrderedAscending : NSOrderedDescending;
+            }
+            return ra.origin.y < rb.origin.y ? NSOrderedAscending :
+                   ra.origin.y > rb.origin.y ? NSOrderedDescending : NSOrderedSame;
+        }];
+    }
+    bool changed = false;
+    for (int i = 1; i < pingouin_outputs; i++) {
+        PingouinHead *hd = &pingouin_heads[i];
+        bool keep = false;
+        for (NSScreen *s in screens) {
+            keep |= hd->display && pingouin_screen_id(s) == hd->display;
+        }
+        if (hd->display && !keep) {
+            pingouin_head_off(hd);
+            changed = true;
+        }
+    }
+    for (NSScreen *s in screens) {
+        CGDirectDisplayID id = pingouin_screen_id(s);
+        bool has = false;
+        for (int i = 1; i < pingouin_outputs; i++) {
+            has |= pingouin_heads[i].display == id;
+        }
+        for (int i = 1; i < pingouin_outputs && !has; i++) {
+            if (!pingouin_heads[i].display) {
+                pingouin_head_on(&pingouin_heads[i], s);
+                has = true;
+                changed = true;
+            }
+        }
+    }
+    if (changed) {
+        /* The guest moves its outputs now; until it says where, use the Mac's layout. */
+        pingouin_guest_known = false;
+    }
+    if (changed) {
+        pingouin_heads_ui_info();
+    }
+    pingouin_update_mac_layout();
+    pingouin_send_layout();
+    pingouin_full_next();
+}
+
+/* The guest channel: app.pingouin.display (JSON lines). */
+
+static int pingouin_chan_fd = -1;
+static dispatch_source_t pingouin_chan_src;
+static NSMutableData *pingouin_chan_buf;
+static int pingouin_chan_tries;
+
+static void pingouin_chan_connect(void);
+
+static void pingouin_chan_write(NSString *line)
+{
+    NSData *d = [[line stringByAppendingString:@"\n"] dataUsingEncoding:NSUTF8StringEncoding];
+    const char *p = [d bytes];
+    size_t left = [d length];
+
+    while (pingouin_chan_fd >= 0 && left) {
+        ssize_t n = write(pingouin_chan_fd, p, left);
+        if (n > 0) {
+            p += n;
+            left -= n;
+        } else if (n < 0 && errno == EINTR) {
+            continue;
+        } else {
+            /* The guest is not reading (port closed): it asks again with hello. */
+            break;
+        }
+    }
+}
+
+static void pingouin_send_layout(void)
+{
+    NSMutableArray *outputs = [NSMutableArray array];
+    NSWindow *mw = [cocoaView window];
+    NSString *builtin = nil;
+
+    if (pingouin_chan_fd < 0 || !pingouin_guest_ready) {
+        return;
+    }
+    for (int i = 0; i < pingouin_outputs; i++) {
+        PingouinBox b = pingouin_mac_box[i];
+        NSScreen *s = i ? pingouin_screen_with_id(pingouin_heads[i].display) : [mw screen];
+        NSString *name = [NSString stringWithFormat:@"Virtual-%d", i + 1];
+        if (b.w <= 0) {
+            continue;
+        }
+        /* The output on the Mac's own display (the notch), for Omanotch. */
+        if (s && !builtin && CGDisplayIsBuiltin(pingouin_screen_id(s))) {
+            builtin = name;
+        }
+        [outputs addObject:@{
+            @"output": name,
+            @"x": @(lround(b.x)), @"y": @(lround(b.y)),
+            @"width": @(lround(b.w)), @"height": @(lround(b.h)),
+            @"scale": @(s ? [s backingScaleFactor] : [mw backingScaleFactor]),
+        }];
+    }
+    NSMutableDictionary *msg = [NSMutableDictionary dictionaryWithDictionary:@{
+        @"layout": outputs,
+        @"external": @(pingouin_external_enabled),
+        @"fullscreen": @(pingouin_main_full_screen()),
+    }];
+    if (builtin) {
+        msg[@"builtin"] = builtin;
+    }
+    NSData *json = [NSJSONSerialization dataWithJSONObject:msg
+                                                   options:NSJSONWritingSortedKeys
+                                                     error:nil];
+    NSString *line = json ? [[[NSString alloc] initWithData:json
+                                                   encoding:NSUTF8StringEncoding] autorelease] : nil;
+    if (!line || [line isEqualToString:pingouin_last_layout]) {
+        return;
+    }
+    [pingouin_last_layout release];
+    pingouin_last_layout = [line retain];
+    if (getenv("PINGOUIN_DISPLAYS_DEBUG")) {
+        fprintf(stderr, "pingouin-displays: mac: %s\n", [line UTF8String]);
+    }
+    pingouin_chan_write(line);
+}
+
+/*
+ * A number from the guest's JSON. Anything else (null, a string, an array)
+ * would raise an exception on -doubleValue and abort QEMU, so it is refused.
+ */
+static bool pingouin_json_number(id v, double *out)
+{
+    if (![v isKindOfClass:[NSNumber class]]) {
+        return false;
+    }
+    *out = [v doubleValue];
+    return isfinite(*out) && fabs(*out) < 1e7;
+}
+
+/* Where Hyprland put its outputs (logical pixels), for the pointer. */
+static void pingouin_guest_monitors(NSArray *monitors)
+{
+    double minx = 0, miny = 0, maxx = 0, maxy = 0;
+    bool first = true;
+
+    memset(pingouin_guest_box, 0, sizeof(pingouin_guest_box));
+    pingouin_guest_known = false;
+    for (NSDictionary *m in monitors) {
+        if (![m isKindOfClass:[NSDictionary class]]) {
+            continue;
+        }
+        NSString *name = m[@"name"];
+        double x, y, w, h;
+        if (!pingouin_json_number(m[@"x"], &x) || !pingouin_json_number(m[@"y"], &y) ||
+            !pingouin_json_number(m[@"width"], &w) ||
+            !pingouin_json_number(m[@"height"], &h) || w <= 0 || h <= 0) {
+            continue;
+        }
+        if (first) {
+            minx = x; miny = y; maxx = x + w; maxy = y + h;
+            first = false;
+        } else {
+            minx = MIN(minx, x); miny = MIN(miny, y);
+            maxx = MAX(maxx, x + w); maxy = MAX(maxy, y + h);
+        }
+        if ([name isKindOfClass:[NSString class]] && [name hasPrefix:@"Virtual-"]) {
+            int index = [[name substringFromIndex:8] intValue] - 1;
+            if (index >= 0 && index < PINGOUIN_MAX_OUTPUTS) {
+                pingouin_guest_box[index] = (PingouinBox){ x, y, w, h };
+                pingouin_guest_known = true;
+            }
+        }
+    }
+    pingouin_guest_bounds = (PingouinBox){ minx, miny, maxx - minx, maxy - miny };
+}
+
+/*
+ * Changes the guest asks for open and close windows and move them in and
+ * out of full screen on the user's displays. At most one per second: a
+ * guest that flips "external" on and off quickly gets its last word applied.
+ */
+static void pingouin_guest_update(void)
+{
+    static CFAbsoluteTime last;
+    static bool pending;
+    CFAbsoluteTime wait = last + 1.0 - CFAbsoluteTimeGetCurrent();
+
+    if (pending) {
+        return;
+    }
+    if (wait <= 0) {
+        last = CFAbsoluteTimeGetCurrent();
+        pingouin_displays_update();
+        return;
+    }
+    pending = true;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(wait * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        pending = false;
+        last = CFAbsoluteTimeGetCurrent();
+        pingouin_displays_update();
+    });
+}
+
+static void pingouin_chan_line(NSData *data)
+{
+    if (getenv("PINGOUIN_DISPLAYS_DEBUG")) {
+        fprintf(stderr, "pingouin-displays: guest: %.*s\n", (int)[data length],
+                (const char *)[data bytes]);
+    }
+    @autoreleasepool {
+        id obj = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        if (![obj isKindOfClass:[NSDictionary class]]) {
+            return;
+        }
+        NSDictionary *d = obj;
+        bool update = false;
+        if (d[@"hello"]) {
+            pingouin_guest_ready = true;
+            [pingouin_last_layout release];
+            pingouin_last_layout = nil;
+            update = true;
+        }
+        if ([d[@"external"] isKindOfClass:[NSNumber class]] &&
+            [d[@"external"] boolValue] != pingouin_external_enabled) {
+            pingouin_external_enabled = [d[@"external"] boolValue];
+            update = true;
+        }
+        if ([d[@"monitors"] isKindOfClass:[NSArray class]]) {
+            pingouin_guest_monitors(d[@"monitors"]);
+        }
+        if (update) {
+            pingouin_guest_update();
+        }
+    }
+}
+
+static void pingouin_chan_close(void)
+{
+    if (pingouin_chan_src) {
+        dispatch_source_cancel(pingouin_chan_src);
+        dispatch_release(pingouin_chan_src);
+        pingouin_chan_src = NULL;
+    }
+    pingouin_chan_fd = -1;
+    pingouin_guest_ready = false;
+    pingouin_chan_tries = 0;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                   dispatch_get_main_queue(), ^{ pingouin_chan_connect(); });
+}
+
+static void pingouin_chan_read(void)
+{
+    char buf[4096];
+    ssize_t n = read(pingouin_chan_fd, buf, sizeof(buf));
+
+    if (n == 0 || (n < 0 && errno != EAGAIN && errno != EINTR)) {
+        pingouin_chan_close();
+        return;
+    }
+    if (n < 0) {
+        return;
+    }
+    [pingouin_chan_buf appendBytes:buf length:n];
+    for (;;) {
+        const char *p = [pingouin_chan_buf bytes];
+        const char *nl = memchr(p, '\n', [pingouin_chan_buf length]);
+        if (!nl) {
+            break;
+        }
+        NSUInteger len = nl - p;
+        pingouin_chan_line([pingouin_chan_buf subdataWithRange:NSMakeRange(0, len)]);
+        [pingouin_chan_buf replaceBytesInRange:NSMakeRange(0, len + 1) withBytes:NULL length:0];
+    }
+    if ([pingouin_chan_buf length] > 65536) {
+        [pingouin_chan_buf setLength:0];
+    }
+}
+
+static void pingouin_chan_connect(void)
+{
+    const char *path = getenv("PINGOUIN_DISPLAY_SOCKET");
+    struct sockaddr_un addr = { 0 };
+    int one = 1;
+
+    if (!path || !*path || pingouin_chan_fd >= 0 || strlen(path) >= sizeof(addr.sun_path)) {
+        return;
+    }
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return;
+    }
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, path);
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+    if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) != 0) {
+        close(fd);
+        if (++pingouin_chan_tries < 120) {
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                           dispatch_get_main_queue(), ^{ pingouin_chan_connect(); });
+        }
+        return;
+    }
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    pingouin_chan_fd = fd;
+    if (!pingouin_chan_buf) {
+        pingouin_chan_buf = [[NSMutableData alloc] init];
+    }
+    [pingouin_chan_buf setLength:0];
+    pingouin_chan_src = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, fd, 0,
+                                             dispatch_get_main_queue());
+    dispatch_source_set_event_handler(pingouin_chan_src, ^{ pingouin_chan_read(); });
+    dispatch_source_set_cancel_handler(pingouin_chan_src, ^{ close(fd); });
+    dispatch_resume(pingouin_chan_src);
+}
+
+/* Main thread, with the BQL (from cocoa_display_init). */
+static void pingouin_displays_init(void)
+{
+    pingouin_heads[0].output = 0;
+#ifdef CONFIG_OPENGL
+    if (display_opengl && gl_view_nsctx) {
+        for (int i = 1; i < PINGOUIN_MAX_OUTPUTS; i++) {
+            QemuConsole *con = qemu_console_lookup_by_index(i);
+            if (!con || !qemu_console_is_graphic(con)) {
+                break;
+            }
+            pingouin_heads[i].output = i;
+            qemu_console_register_listener(con, &pingouin_heads[i].dcl, &pingouin_head_gl_ops);
+            pingouin_outputs = i + 1;
+        }
+    }
+#endif
+    pingouin_head_delegate = [[PingouinHeadDelegate alloc] init];
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName:NSApplicationDidChangeScreenParametersNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        /* Displays settle for a moment after a plug or unplug. */
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 2),
+                       dispatch_get_main_queue(), ^{ pingouin_displays_update(); });
+    }];
+    /*
+     * Another app came to the front: let go of the pointer and keyboard even
+     * when the main window was not the key one (windowDidResignKey: covers
+     * that case only).
+     */
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName:NSApplicationDidResignActiveNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        if ([cocoaView isMouseGrabbed]) {
+            [cocoaView ungrabMouse];
+        }
+    }];
+    pingouin_update_mac_layout();
+    pingouin_chan_connect();
+}
+
+/* Test mode: the main window starts on PINGOUIN_TEST_MAIN_DISPLAY. */
+static void pingouin_place_main_window(void)
+{
+    const char *v = getenv("PINGOUIN_TEST_MAIN_DISPLAY");
+    NSScreen *s = v && *v ? pingouin_screen_with_id((CGDirectDisplayID)atoll(v)) : nil;
+
+    if (s) {
+        NSRect r = NSInsetRect([s visibleFrame], 40, 40);
+        [[cocoaView window] setFrame:r display:YES];
+    }
+}
