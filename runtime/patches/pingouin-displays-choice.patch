-            } else if (left == 0) {
+            } else if (left == 0 && pingouin_choice_allows(s)) {
+                /* Pingouin: only displays the user chose for the VM. */
                 [screens addObject:s];
             }
         }
@@ -12276,6 +12560,7 @@
 #endif
